            "rollback": "Automatic on failure"
          },
          "purpose": "Declarative infrastructure deployment"
        },
        {
          "name": "Terraform Resources",
          "type": "Infrastructure as Code",
          "specifications": {
            "provider": "AWS",
            "state_backend": "S3 + DynamoDB",
            "version": "Latest compatible"
          },
          "purpose": "Alternative IaC deployment method"
        },
        {
          "name": "ROSA CLI",
          "type": "Command Line Interface",
          "specifications": {
            "authentication": "Red Hat SSO",
            "aws_integration": "IAM roles/profiles",
            "cluster_management": "Full lifecycle"
          },
          "purpose": "ROSA cluster management and operations"
        }
      ]
    }
  },
